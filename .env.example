# Copy to .env.local for local development; set the same values in Vercel for production.

# Supabase project (Settings → API). The service-role key is server-only and never
# reaches the browser — this app has no NEXT_PUBLIC_ Supabase variables on purpose.
SUPABASE_URL=https://bethrbtergsvtafmsgpy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs the session cookie. Generate with:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Shown in the PDF header and the app. Defaults are Almstead HQ.
COMPANY_ADDRESS=58 Beechwood Avenue, New Rochelle NY 10801
COMPANY_PHONE=914-576-0193
COMPANY_FAX=914-576-1117
